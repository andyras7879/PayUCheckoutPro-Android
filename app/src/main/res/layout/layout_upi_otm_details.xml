<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Payment Start Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_payment_start_date_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:enabled="false"
            android:focusable="false"
            android:text="Payment Start Date"
            android:textColor="@android:color/holo_blue_light" />

        <EditText
            android:id="@+id/et_payment_start_date_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:hint="YYYY-MM-DD"
            android:text="2025-04-14" />
    </LinearLayout>

    <!-- Payment End Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_payment_end_date_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:enabled="false"
            android:focusable="false"
            android:text="Payment End Date"
            android:textColor="@android:color/holo_blue_light" />

        <EditText
            android:id="@+id/et_payment_end_date_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:hint="YYYY-MM-DD"
            android:text="2025-04-21" />
    </LinearLayout>

    <!-- Pre Auth Transaction -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_pre_auth_txn_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:enabled="false"
            android:focusable="false"
            android:text="Pre Auth Transaction"
            android:textColor="@android:color/holo_blue_light" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_pre_auth_txn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:checked="true" />
    </LinearLayout>

</LinearLayout>